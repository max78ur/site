import { Suspense, useState, useEffect } from 'react';
import { Routes, Route, Navigate } from 'react-router-dom';
import Navbar from './components/navigation/Navbar';
import Footer from './components/layout/Footer';
import Home from './pages/Home';
import LoadingScreen from '@/components/loading/LoadingScreen';
import '@/components/hero/CinematicHero.css';

// Global CSS import for hero
import '@/app/globals.css';

let didInitialize = false;

function App() {
  useEffect(() => {
    if (didInitialize) return;
    didInitialize = true;

    // Initialize GSAP animations after first render
    const { gsap } = (window as any);

    // Initialize barba.js or similar page transition could go here
    // For now, just ensure smooth scroll
    document.documentElement.style.scrollBehavior = 'smooth';
  }, []);

  return (
    <div className="min-h-screen bg-black selection:bg-primary-red selection:text-white">
      <Navbar />

      <Suspense fallback={null}>
        <Routes>
          <Route path="/" element={<Home />} />
          <Route path="/about" element={<About />} />
          <Route path="/services" element={<Services />} />
          <Route path="/services/dry-van" element={<DryVan />} />
          <Route path="/services/reefer" element={<Reefer />} />
          <Route path="/services/flatbed" element={<Flatbed />} />
          <Route path="/services/power-only" element={<PowerOnly />} />
          <Route path="/contact" element={<Contact />} />
          <Route path="/carrier-signup" element={<CarrierSignup />} />
          <Route path="/faq" element={<FAQ />} />
          <Route path="/privacy-policy" element={<PrivacyPolicy />} />
          <Route path="/terms" element={<Terms />} />
          <Route path="*" element={<Navigate to="/" replace />} />
        </Routes>
      </Suspense>

      <Footer />
    </div>
  );
}

export default App;
